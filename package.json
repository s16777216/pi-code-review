{
  "name": "@s16777216/pi-code-review",
  "version": "0.1.0",
  "description": "AI code review for GitLab merge requests, driven by pi-agent-core/pi-ai and OpenAI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s16777216/pi-code-review.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "picr": "./dist/index.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "release": "commit-and-tag-version",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^1.4.0",
    "@earendil-works/pi-ai": "^1.4.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "commit-and-tag-version": "^13.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20"
  }
}
